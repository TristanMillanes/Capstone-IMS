# Render provides PORT automatically.
# PORT=10000

# Optional OCR tuning
OCR_LANG=eng
OCR_WORKERS=1
OCR_DOCUMENT_WORKERS=1
OCR_PAGE_CACHE_SIZE=64
OCR_DPI=220
OCR_MAX_SIDE=2800
OCR_TIMEOUT=45
OCR_DOCUMENT_TIMEOUT=180
OCR_CACHE_SIZE=20
OCR_CACHE_TTL=600

# Only needed if the frontend is hosted on a different domain.
# When PGENRO and OCR are served by this same Docker service, leave this unset.
# OCR_ALLOWED_ORIGIN=https://your-pgenro-domain.example
